# SKINMATE AI - Environment Configuration Example

# Groq LLM API Key (used for agentic skincare assistant reasoning)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Perfect Corp YouCam Skin AI REST API Credentials
# Get your permanent API key and units from: https://yce.perfectcorp.com
YOUCAM_API_KEY=sk-your_youcam_api_key_here
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com

# Supabase Auth & PostgreSQL Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
